# Backend base URL used by the production web build AND the Android (Capacitor) app.
# The Android app has NO dev proxy, so this MUST point at a publicly reachable
# backend. Leave NO trailing slash.
#
# Live backend — the custom domain for the same Render service that used to be
# addressed as smarttask-api-nwpy.onrender.com (both resolve to one deployment;
# the branded domain survives a Render service rename, the onrender.com one doesn't):
VITE_API_BASE=https://taskmanager.befach.com

# Google Sign-In — the Web OAuth client id (see docs/GOOGLE_SIGNIN_SETUP.md).
# Must equal the backend's GOOGLE_CLIENT_ID. Empty = Google button hidden.
VITE_GOOGLE_CLIENT_ID=

# Wake word: OFF until hey_votask.onnx is trained.
#
# This MUST be set explicitly to false, not merely left out. Vite loads `.env` in
# every mode, including production, and `.env` sets this to true for local
# development — so omitting it here does not disable anything, it silently
# inherits the dev value. That is exactly how the v2 build ended up shipping an
# enabled wake word running openWakeWord's non-commercial "hey jarvis"
# placeholder model.
#
# With this false, vite.config.ts also drops the ONNX runtime and the model files
# from the bundle (~9 MB) instead of shipping code that can never run.
VITE_WAKEWORD_ENABLED=false
