# SmartTask web client — environment template.
# Copy to `client/.env` for local dev (Vite reads it). Production values live in
# `client/.env.production`. NEVER commit your real .env.

# Backend base URL. Leave EMPTY for local dev — Vite proxies /api → :4000.
# Set only for a build that talks to a remote backend.
VITE_API_BASE=

# Google Sign-In — the Web OAuth client id from Google Cloud Console
# (see docs/GOOGLE_SIGNIN_SETUP.md). Must equal the backend's GOOGLE_CLIENT_ID.
# Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=

# Voice assistant wake word ("hey BTM") — free, no key, no per-user cost. Set to
# "true" to enable it; leave unset to use tap-the-mic only (the voice assistant
# still works fully). See docs/VOICE_ASSISTANT_SETUP.md.
VITE_WAKEWORD_ENABLED=
# Detector: "speech" (browser SpeechRecognition matching the words "hey btm" —
# works with no trained model, but needs network and is Chrome/Android only) or
# "onnx" (on-device openWakeWord — offline and cheap, needs a trained
# hey_btm.onnx plus the 2 shared models in client/public/wakeword/).
# VITE_WAKEWORD_MODE=speech
# -- speech mode --
# VITE_WAKEWORD_LANG=en-IN
# Extra comma-separated spellings to accept for whatever the device mis-hears
# "btm" as (also settable live via localStorage 'wakeword_extra').
# VITE_WAKEWORD_EXTRA=
# -- onnx mode --
# Detection sensitivity (0..1). Lower = more sensitive / more false triggers.
# VITE_WAKEWORD_THRESHOLD=0.5
# Optional model path overrides (defaults live under /wakeword/).
# VITE_WAKEWORD_MELSPEC_PATH=/wakeword/melspectrogram.onnx
# VITE_WAKEWORD_EMBEDDING_PATH=/wakeword/embedding_model.onnx
# VITE_WAKEWORD_MODEL_PATH=/wakeword/hey_btm.onnx
# Where onnxruntime-web loads its WASM. Default is a CDN; set to a self-hosted
# path (e.g. /ort/) for fully offline / Android use.
# VITE_ORT_WASM_PATH=/ort/
