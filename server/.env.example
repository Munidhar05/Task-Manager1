# SmartTask backend — environment template.
# Copy to `server/.env` and fill in. NEVER commit your real .env (it's gitignored).

PORT=4000
# Strong random string for signing JWTs. On Render this is auto-generated.
JWT_SECRET=change-me-in-production-please

# ---- Google Sign-In (optional; enables the "Continue with Google" button) ----
# The Web OAuth client id from Google Cloud Console (see docs/GOOGLE_SIGNIN_SETUP.md).
# MUST match the client's VITE_GOOGLE_CLIENT_ID. Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
# Only for the Android/iOS app: the extra platform OAuth client id(s), comma-separated.
# Native id tokens carry the mobile client id in `aud`, so it must be accepted too.
GOOGLE_CLIENT_IDS_EXTRA=

# ---- AI engine (optional; app falls back to the offline rule-based engine) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=

# ---- Audio transcription (optional) ----
TRANSCRIPTION_PROVIDER=sarvam
OPENAI_TRANSCRIBE_MODEL=whisper-1
SARVAM_API_KEY=
SARVAM_LANGUAGE=en-IN

# ---- Assistant voice / text-to-speech (optional) ----
# ElevenLabs gives the voice assistant a natural voice instead of the device's
# built-in one. Leave blank and it falls back to Android TTS / speechSynthesis —
# the assistant still speaks, it just sounds like a screen reader.
# Billed per CHARACTER; usage is recorded per org under the 'voice_tts' feature.
# NOTE: this file is COMMITTED — it is the template, not your config. Put the real
# key in server/.env, which is git-ignored. Leave this blank.
ELEVENLABS_API_KEY=
# Voice to use. Default is Rachel (21m00Tcm4TlvDq8ikWAM) — calm and neutral.
# Browse others at elevenlabs.io/app/voice-library and paste the voice ID here.
ELEVENLABS_VOICE_ID=
# Turbo is the default: measured fastest on this app's actual sentences (~0.5-0.6s
# round-trip vs ~0.8s for flash and ~1.3-2.6s for eleven_v3). Latency matters more
# than expressiveness here — every reply is one short status line, and the loop only
# re-opens the mic after the assistant finishes speaking. See src/ai/speech.js.
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ---- Daily task digest (optional) ----
CLIQ_WEBHOOK_URL=
DIGEST_HOUR=8

# ---- Email (Brevo SMTP) — powers verification, password reset & team invites ----
# Sender domain must be authenticated in Brevo for good deliverability.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=          # your Brevo LOGIN email (Brevo → SMTP & API → Login)
SMTP_PASS=          # your Brevo SMTP KEY  (Brevo → SMTP & API → Generate a new SMTP key)
MAIL_FROM=Befach Task Manager <noreply@taskmanager.befach.com>

# Base URL for links inside emails. Local: http://localhost:5173
# Production (Render): your public app URL, e.g. https://smarttask-api-xxxx.onrender.com
APP_URL=http://localhost:5173
